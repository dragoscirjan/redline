{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Curated skill sources and adaptation intent",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "repository", "ref", "skills"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "repository": { "type": "string", "pattern": "^https://github\\.com/[\\w.-]+/[\\w.-]+$" },
    "ref": { "type": "string", "minLength": 1 },
    "defaults": {
      "type": "object", "additionalProperties": false,
      "properties": { "exclude": { "$ref": "#/$defs/strings" } }
    },
    "skills": {
      "type": "object", "maxProperties": 1000,
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/skill" }
    },
    "deprecations": {
      "type": "object", "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["replacements", "reason"],
        "properties": {
          "replacements": { "$ref": "#/$defs/names" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "instructionTemplates": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" }, "issue": { "type": "integer", "minimum": 1 },
        "path": { "type": "string", "minLength": 1 },
        "prerequisites": {
          "type": "array", "uniqueItems": true, "minItems": 4, "maxItems": 4,
          "items": { "enum": ["isolated-workspace", "document-project", "asd-ste100-technical", "unslop"] }
        }
      },
      "allOf": [{ "if": { "properties": { "enabled": { "const": true } } }, "then": { "required": ["path", "prerequisites"] } }]
    }
  },
  "$defs": {
    "name": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "strings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "names": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/name" } },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": { "enum": ["local", "github"] },
        "path": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "pattern": "^https://github\\.com/[\\w.-]+/[\\w.-]+$" },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      },
      "allOf": [{ "if": { "properties": { "type": { "const": "github" } } }, "then": { "required": ["repository", "revision"] } }]
    },
    "skill": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "description", "source", "harnesses", "install"],
      "properties": {
        "kind": { "enum": ["authored", "upstream", "adapted"] },
        "description": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source" },
        "upstream": { "$ref": "#/$defs/source" },
        "scope": { "enum": ["personal", "project"] },
        "category": { "type": "string" },
        "selection": { "enum": ["optional", "recommended", "detected", "wrapper", "initializer"] },
        "safety": { "type": "string" },
        "signals": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "files": { "$ref": "#/$defs/strings" },
            "extensions": { "$ref": "#/$defs/strings" },
            "askWithoutSignals": { "type": "boolean", "description": "Legacy advisory metadata; every remaining entry is offered regardless." }
          }
        },
        "harnesses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["pi", "opencode", "claude-code"] } },
        "capabilities": { "$ref": "#/$defs/strings" },
        "runtime": { "$ref": "#/$defs/strings" },
        "prerequisites": { "$ref": "#/$defs/names" },
        "include": { "$ref": "#/$defs/strings" },
        "exclude": { "$ref": "#/$defs/strings" },
        "install": {
          "type": "object", "additionalProperties": false, "required": ["argv"],
          "properties": { "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } }
        },
        "legal": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "target", "spdx"],
            "properties": { "path": { "type": "string", "minLength": 1 }, "target": { "type": "string", "minLength": 1 }, "spdx": { "type": "string", "minLength": 1 } }
          }
        },
        "adaptation": {
          "type": "object", "additionalProperties": false, "required": ["instructions"],
          "properties": { "instructions": { "type": "string", "minLength": 1 }, "review": { "$ref": "#/$defs/strings" } }
        }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "adapted" } } }, "then": { "required": ["adaptation"] } },
        { "if": { "properties": { "kind": { "const": "upstream" } } }, "then": { "properties": { "source": { "properties": { "type": { "const": "github" } } } } } }
      ]
    }
  }
}
