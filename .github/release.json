{
  "version": 1,
  "engine": "changesets",
  "project": {
    "path": ".",
    "executor": "pnpm",
    "package_manager": "pnpm",
    "use_mise": false
  },
  "publishing": {
    "before": [
      "release:preflight"
    ],
    "create_github_releases": false,
    "push_git_tags": false
  },
  "pull_request": {
    "title": "chore(release): version package",
    "commit_message": "chore(release): version package",
    "base_branch": "main"
  }
}
