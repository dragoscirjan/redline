  "cards": [
    {
      "dot": "cyan",
      "title": "Read the final outcome",
      "items": [
        "completed does not mean no findings or semantic proof.",
        "Each accepted run emits one finished event while output remains writable."
      ]
    },
    {
      "dot": "amber",
      "title": "running to cancelled",
      "items": [
        "Cancellation signals pending work. The acknowledgement may still say running until children stop and artifacts settle.",
        "If completion wins the cancellation race, the completed outcome is preserved."
      ]
    },
    {
      "dot": "slate",
      "title": "EOF and recovery",
      "items": [
        "Persistent stdin EOF cancels pending work; --once EOF drains its accepted run.",
        "A broken connection is not a terminal success. Inspect the saved status.json."
      ]
    }
  ]
