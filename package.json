{
  "name": "redline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Forge-independent pull request review core and forge-specific actions.",
  "bin": {
    "redline-review": "dist/src/review/cli.js"
  },
  "scripts": {
    "benchmark": "pnpm run build && node dist/src/benchmark/cli.js",
    "benchmark:live-model": "pnpm run build && node dist/src/benchmark/live-cli.js",
    "benchmark:performance": "pnpm run build && node dist/src/benchmark/performance-cli.js",
    "benchmark:code-index-value": "pnpm run build && node dist/src/benchmark/code-index-value-cli.js",
    "benchmark:performance:live": "pnpm run build && node dist/src/benchmark/performance-cli.js --live",
    "benchmark:verification": "pnpm run build && node dist/src/benchmark/verification-cli.js",
    "benchmark:live-verification": "pnpm run build && node dist/src/benchmark/live-verification-cli.js",
    "benchmark:judge-live-verification": "pnpm run build && node dist/src/benchmark/judge-live-verification.js",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "docs": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "serve": "vitepress dev docs",
    "test": "pnpm run build && vitest run && bats test/*.bats",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "bats": "^1.12.0",
    "typescript": "5.9.3",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4"
  }
}
