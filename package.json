{
  "name": "redline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Forge-independent pull request review core and forge-specific actions.",
  "bin": {
    "redline-review-prompt": "dist/src/review-prompt-cli.js",
    "redline-review-run": "dist/src/review-run-cli.js",
    "redline-github-action": "dist/src/github-action-run-cli.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "docs": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "serve": "vitepress dev docs",
    "test": "pnpm run build && node --test dist/test/*.test.js && bats test/*.bats",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "bats": "^1.12.0",
    "typescript": "5.9.3",
    "vitepress": "^1.6.4"
  }
}
