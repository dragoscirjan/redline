{
  "name": "redline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Forge-independent pull request review core and forge-specific actions.",
  "bin": {
    "redline-review": "dist/src/review/cli.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "docs": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "serve": "vitepress dev docs",
    "test": "pnpm run build && vitest run && bats test/*.bats",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "bats": "^1.12.0",
    "typescript": "5.9.3",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4"
  }
}
