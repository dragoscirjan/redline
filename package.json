{
  "name": "@dragoscirjan/redline",
  "version": "1.2.2",
  "type": "module",
  "description": "Initiative 4.0 scaffold for local and containerized code reviews.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dragoscirjan/redline.git"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {},
  "files": [
    "bin/*.mjs",
    "dist/**/*.js",
    "src/cli/*.ts",
    "src/application/*.ts"
  ],
  "bin": {
    "redline": "bin/redline.mjs",
    "redline-review": "bin/redline-review.mjs"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "prepack": "pnpm run build",
    "docs": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "serve": "vitepress dev docs",
    "test": "vitest run && bats test/*.bats",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:package": "vitest run test/package.test.ts"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "24.10.1",
    "bats": "^1.12.0",
    "typescript": "5.9.3",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "execa": "^10.2.1"
  }
}
